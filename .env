# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# ── Whisper ───────────────────────────────────────────────────────────────
WHISPER_BACKEND=local
WHISPER_MODEL=base

# ── Interview flow ────────────────────────────────────────────────────────
DEFAULT_INTERVIEW_LEVEL=mid
MIN_QUESTIONS=5
MAX_QUESTIONS=12
FOLLOWUP_SCORE_THRESHOLD=6.0
WEAK_SCORE_THRESHOLD=4.0

# ── Optional: LLaVA video analysis ───────────────────────────────────────
# Run: ollama pull llava
# If not pulled, system falls back to basic OpenCV analysis automatically
